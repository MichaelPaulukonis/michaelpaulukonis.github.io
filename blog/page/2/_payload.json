[{"data":1,"prerenderedAt":725},["ShallowReactive",2],{"blog-list-2":3},{"posts":4,"totalPages":53},[5,141,315,392,661],{"id":6,"title":7,"author":8,"body":9,"date":121,"dateUpdated":122,"description":7,"excerpt":122,"extension":123,"headline":7,"meta":124,"navigation":126,"path":127,"seo":128,"socialImage":129,"stem":134,"tags":135,"__hash__":140},"blog/blog/nuxt-content-blog.md","A Nuxt blog using Content","Michael Paulukonis",{"type":10,"value":11,"toc":118},"minimark",[12,16,27,30,33,81,86,100,105,114],[13,14,7],"h1",{"id":15},"a-nuxt-blog-using-content",[17,18,19,20],"p",{},"This static blog is based on ",[21,22,26],"a",{"href":23,"rel":24},"https://github.com/GonzaloHirsch/nuxt-blog-starter",[25],"nofollow","Nuxt Blog Starter",[17,28,29],{},"I've smushed in (\"integrated\" is perhaps too generous) a different style for the front page, and am forcing it into the blog pages, as well.",[17,31,32],{},"I've also had to upgrade Nuxt and some other dependencies.",[34,35,40],"pre",{"className":36,"code":37,"language":38,"meta":39,"style":39},"language-shell shiki shiki-themes github-light github-dark","> nvm use 18\n> rm package-lock.json\n> rm -rf node_modules\n> npm i -d nuxt@latest\n> npm i -D @nuxtjs/tailwindcss@latest\n> npx nuxi@latest devtools enable\n","shell","",[41,42,43,51,57,63,69,75],"code",{"__ignoreMap":39},[44,45,48],"span",{"class":46,"line":47},"line",1,[44,49,50],{},"> nvm use 18\n",[44,52,54],{"class":46,"line":53},2,[44,55,56],{},"> rm package-lock.json\n",[44,58,60],{"class":46,"line":59},3,[44,61,62],{},"> rm -rf node_modules\n",[44,64,66],{"class":46,"line":65},4,[44,67,68],{},"> npm i -d nuxt@latest\n",[44,70,72],{"class":46,"line":71},5,[44,73,74],{},"> npm i -D @nuxtjs/tailwindcss@latest\n",[44,76,78],{"class":46,"line":77},6,[44,79,80],{},"> npx nuxi@latest devtools enable\n",[82,83],"div",{"className":84},[85],"mb-12",[82,87,89],{"className":88},[85],[17,90,91,92,95,96,99],{},"Enabling ",[41,93,94],{},"devtools"," is not required if you've already added it to your ",[41,97,98],{},"nuxt.config.ts",".",[101,102,104],"h2",{"id":103},"styling-originally-based-on-marina-aisas-nuxt-markdown-blog","Styling originally based on Marina Aisa's nuxt-markdown-blog",[17,106,107,108,113],{},"Marina's ",[21,109,112],{"href":110,"rel":111},"https://github.com/marinaaisa/nuxt-markdown-blog-starter",[25],"nuxt markdown blog starter"," was the original basis for the design, but the colors were electrified and more things changed. I hope to iteratively come up with a legible compromise between several designs. I may be an artist and a programmer, but CSS is not my favorite medium.",[115,116,117],"style",{},"html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":39,"searchDepth":53,"depth":53,"links":119},[120],{"id":103,"depth":53,"text":104},"2025-03-22T16:00:00.000Z",null,"md",{"authorUrl":125},"https://michael.paulukonis.github.io/",true,"/blog/nuxt-content-blog",{"title":7,"description":7},{"src":130,"mime":131,"alt":122,"width":132,"height":133},"/media/polychrometext.thumb.jpg","webp",900,583,"blog/nuxt-content-blog",[136,137,41,138,139],"blog","programming","nuxt","vuejs","3gaFgak5GARGvDJUWhbkX5YJz8kSBJQ-nYSZpwJeuOM",{"id":142,"title":143,"author":8,"body":144,"date":297,"dateUpdated":122,"description":298,"excerpt":122,"extension":123,"headline":143,"meta":299,"navigation":126,"path":300,"seo":301,"socialImage":302,"stem":307,"tags":308,"__hash__":314},"blog/blog/publications.md","Publications",{"type":10,"value":145,"toc":294},[146,153,157],[17,147,148],{},[149,150],"img",{"alt":151,"src":152},"fragment of Backslash Lit No.4","/media/publications.thumb.png",[101,154,156],{"id":155},"places-i-can-or-have-been-found","Places I can or have been found",[158,159,160,170,178,185,193,200,207,227,236,249,257,268,277,286],"ul",{},[161,162,163,164,169],"li",{},"Perspective magazine published ",[21,165,168],{"href":166,"rel":167},"https://abc.perspektive.at/obscurator-visually-difficult/",[25],"OBSCURUS",", 2020/2021",[161,171,172,177],{},[21,173,176],{"href":174,"rel":175},"https://www.utsanga.it/paulukonis-works-a-short-anthology/",[25],"Utsanga",", March 2021",[161,179,180,184],{},[21,181,176],{"href":182,"rel":183},"https://www.utsanga.it/paulukonis-works/",[25],", Dec. 2020",[161,186,187,192],{},[21,188,191],{"href":189,"rel":190},"https://web.njit.edu/~newrev/3.0/paulukonis.html",[25],"5 Emotional Spam Poems"," in the Newark Review 3.0",[161,194,195],{},[21,196,199],{"href":197,"rel":198},"https://backslashlit.com/issues/4/michael-paulukonis",[25],"Backslash Lit #4",[161,201,202],{},[21,203,206],{"href":204,"rel":205},"https://backslashlit.com/issues/2/michael-j-paulukonis-hex-kilo-gram",[25],"Backslash Lit #2",[161,208,209,210],{},"Issac Karth's (late, lamented) Procedural Generation Blog has done an overview of a few things:\n",[158,211,212,219],{},[161,213,214],{},[21,215,218],{"href":216,"rel":217},"https://procedural-generation.isaackarth.com/2016/03/29/automated-fairy-tales.html",[25],"FairyTalesBot",[161,220,221,226],{},[21,222,225],{"href":223,"rel":224},"https://procedural-generation.isaackarth.com/2015/11/26/134033376013.html",[25],"LE Omelette D'ARTHUR"," 2013",[161,228,229,230,235],{},"included in ",[21,231,234],{"href":232,"rel":233},"https://www.laurenceking.com/product/instagram-poetry-for-every-day/",[25],"Instagram Poetry for Every Day",", Lawrence King publishing, 2020",[161,237,238,239,243,244],{},"The ",[240,241,242],"em",{},"Cream City Review's"," non-print journal ",[21,245,248],{"href":246,"rel":247},"https://uwm.edu/creamcityreview/cheshire-michael-paulukonis/",[25],"Chesire",[161,250,251,252],{},"Cover of ",[21,253,256],{"href":254,"rel":255},"https://petrichormag.com/petrichor-26/",[25],"Petrichor #26",[161,258,259,260,263,264],{},"part of Techspressionism group show ",[240,261,262],{},"TECHSPRESSIONISM - Digital & Beyond",", at Southampton Arts Center, 2022  ",[21,265,266],{"href":266,"rel":267},"https://techspressionism.com/exhibition/southampton/michael-paulukonis/",[25],[161,269,270,271,276],{},"included in the ",[21,272,275],{"href":273,"rel":274},"https://thewrong.org/Techspressionism",[25],"Techspressionism Pavillion"," at The Wrong Biennale 2023",[161,278,279,280,285],{},"visual poems in Jim Andrews' ",[21,281,284],{"href":282,"rel":283},"https://seaofpo.vispo.com?p=mp",[25],"Sea pf Po",", 2024",[161,287,229,288,293],{},[21,289,292],{"href":290,"rel":291},"https://techspressionism.com/brooklyn",[25],"\"Hello, Brooklyn!\" // Techspressionism 2024"," at the Kingsborough Art Museum, 2024",{"title":39,"searchDepth":53,"depth":53,"links":295},[296],{"id":155,"depth":53,"text":156},"2021-07-01T00:00:00.000Z","Places that have graced me with my presence",{},"/blog/publications",{"title":143,"description":298},{"src":152,"mime":303,"alt":304,"width":305,"height":306},"png","an online web zine",586,413,"blog/publications",[309,310,311,312,313],"publications","writing","poetry","art","pinned","aCubK_VbE_rbHfsATi5_ALHws6dtYOmAeVeBdmgiw0s",{"id":316,"title":317,"author":8,"body":318,"date":378,"dateUpdated":122,"description":379,"excerpt":122,"extension":123,"headline":380,"meta":381,"navigation":126,"path":383,"seo":384,"socialImage":385,"stem":387,"tags":388,"__hash__":391},"blog/blog/polychrometext-introduction.md","Introducing PolychromeText",{"type":10,"value":319,"toc":375},[320,324,327,332,336,344,347,350,353,360,367],[13,321,323],{"id":322},"an-introduction-to-polychrometext","An introduction to PolychromeText",[17,325,326],{},"NOTE: as of 03.2025 this needs a massive update. As does the code.",[17,328,329],{},[149,330],{"alt":331,"src":130},"a working session of PolychromeText showing an older GUI",[101,333,335],{"id":334},"what-are-you-talking-about","What are you talking about?",[17,337,338,343],{},[21,339,342],{"href":340,"rel":341},"https://michaelpaulukonis.github.io/polychrome.p5/",[25],"THIS"," is PolychromeText - a text-painter web-app.",[17,345,346],{},"Ever since I was a wee nipper, I've wanted to be able to create with text the way Jackson Pollock created with paint:\ndripping, flinging, pouring, etc.",[17,348,349],{},"Andy Warhol and Mark Rothko are also influences in various ways. Warhol's screen-prints led me to think how \"text\" is almost infinitely repeatable, and thus not a comodity, like a painting or a print could be. That led me down many roads with physical concrete poetry, typewriters and text paintings. Rothko is perhaps a more oblique influence, but he was me entree to color-field painting, and how several of my college classmates couldn't stand abstract paintings like that - their irritated descriptions filled me with a desire to create something similarly monolithic. I don't think I ever really did anything over-all until recently).",[17,351,352],{},"In early 2014 I took a \"MOOC\" on Processing, and one of my exercises became Polychrometext, so-named since it's second-week of life (it had a brief life as \"Text-Painter\" which is accurate if prosaic). I used the \"Javascript Mode\" to bring the sketch to the web. Eventually, I converted it to use Processing.js, and in 2018 moved on to p5js.",[17,354,355,356,359],{},"The app has continued to evolve, perhaps slowly, as I continue to simultaneously \"focus\" on both the output and the internals - I ",[240,357,358],{},"am"," a programmer during the day, and \"good\" code is important to me. Working on this project is a chance to express my viusal sense, but also exercise my code-skills. That said, I wouldn't necessarily hold it up as a stellar example of my work - it is highly unplanned and imperfect, filled with comments and side-tracks. Hopefully, it does show several things that I care about, and I would encourage anybody who wants to have a long-lived creative-coding project to realize that organizing the code makes it so much easier to grow your code.",[17,361,362,99],{},[21,363,366],{"href":364,"rel":365},"https://www.instagram.com/explore/tags/polychrometext/",[25],"Instragram posts",[17,368,369,370,99],{},"Most of them are also dumped into ",[21,371,374],{"href":372,"rel":373},"https://www.flickr.com/photos/othermichael/albums/72157641585339145",[25],"Flickr",{"title":39,"searchDepth":53,"depth":53,"links":376},[377],{"id":334,"depth":53,"text":335},"2019-09-14T16:00:00.000Z","A browser-based text-drawing program because I was jealous of Jackson Pollock and Mark Rothko","PolychromeText",{"authorUrl":125,"fmContentType":382},"default","/blog/polychrometext-introduction",{"title":317,"description":379},{"src":130,"mime":131,"alt":386,"width":132,"height":133},"an older version of Polychrometext with some GUI elements","blog/polychrometext-introduction",[312,137,389,313,390],"text","p5js","_XYXvGuGQnZs_JsQ0ku7Z7bobdQiRQdhrVKbPmASO4c",{"id":393,"title":394,"author":8,"body":395,"date":645,"dateUpdated":646,"description":647,"excerpt":122,"extension":123,"headline":394,"meta":648,"navigation":126,"path":649,"seo":650,"socialImage":651,"stem":656,"tags":657,"__hash__":660},"blog/blog/automated-bots.md","Automated Art Automatons",{"type":10,"value":396,"toc":642},[397,411,413,423,426,434,437,440,453,457,461],[17,398,399,400,405,406],{},"NOTE: as of 03.2025 just about everything on this list is defunct, except for ",[21,401,404],{"href":402,"rel":403},"https://leanstooneside.tumblr.com/",[25],"ListMania"," and ",[21,407,410],{"href":408,"rel":409},"https://github.com/MichaelPaulukonis/PoeticalBot",[25],"PoeticalBot",[13,412,335],{"id":334},[414,415,416],"blockquote",{},[414,417,418],{},[414,419,420],{},[17,421,422],{},"Well I drove down to Big D.C.\nAnd I walked into Room 1003\nAnd there they were The Big Boys.\nAnd they were talking Big B Little O Little M Silent B\nThey were saying: '''Let's teach those robots how to play hardball.\nLet's teach those little fellas a little gratitude.'''\n-> Laurie Anderson, ''Sharkey's Night'', Home of the Brave, 1985",[17,424,425],{},"I've been writing bots for a while now. Some are still running.",[17,427,428,429,99],{},"I thought about this for over a year, until somebody goaded me into ",[21,430,433],{"href":431,"rel":432},"http://bbs.boingboing.net/t/comprehensively-addressing-the-stupid-intellectually-dishonest-critique-of-anita-sarkeesian/40229/139",[25],"actualizing a joke",[17,435,436],{},"I started out with Google-spreadhsheet-script bots, and \"graduated\" to NodeJs bots running on Heroku.",[17,438,439],{},"I have some ideas for future bots, but who knows. These things are fun, programming exercises, linguistic exercises, artistic expressions, artistic experiments, autistic experiments, and whoknowswhat.",[17,441,442,443,448,449],{},"Bots that use Tracery/",[21,444,447],{"href":445,"rel":446},"http://cheapbotsdonequick.com/",[25],"Cheap Bots Done Quick"," may have some source and notes @ ",[21,450,451],{"href":451,"rel":452},"https://github.com/MichaelPaulukonis/tracery-grammars",[25],[13,454,456],{"id":455},"bots","Bots",[101,458,460],{"id":459},"quick-list","quick list",[158,462,463,469,477,485,493,501,509,516,525,531,537,543,549,555,561,567,573,579,585,591,597,603,609,615,621,628,635],{},[161,464,465],{},[21,466,467],{"href":467,"rel":468},"https://twitter.com/OtherMichael/lists/bots-are-hot/members",[25],[161,470,471,476],{},[21,472,475],{"href":473,"rel":474},"https://twitter.com/BestofTimesBot1",[25],"Best of Times bot"," - best of times/worst of times; pos-tags and replacement from ''A Tale of Two Cities''",[161,478,479,484],{},[21,480,483],{"href":481,"rel":482},"https://twitter.com/PhraseTuner",[25],"Turner of Phrases"," - they are phrases (vague, deceitful)",[161,486,487,492],{},[21,488,491],{"href":489,"rel":490},"https://twitter.com/faith_of_faiths",[25],"Faithful Servants Bot"," - religion generator",[161,494,495,500],{},[21,496,499],{"href":497,"rel":498},"https://twitter.com/FellowshipBot",[25],"Houses of the Holy"," - church generator",[161,502,503,508],{},[21,504,507],{"href":505,"rel":506},"https://twitter.com/WinecriticB",[25],"Wine Critic Bot"," - vineyards, wines and reviews",[161,510,511,515],{},[21,512,513],{"href":513,"rel":514},"https://twitter.com/brewmasterbot",[25]," - craft beers",[161,517,518,521,522],{},[21,519,402],{"href":402,"rel":520},[25]," - aka ",[240,523,524],{},"Lis(z)t Mania",[161,526,527],{},[21,528,529],{"href":529,"rel":530},"https://twitter.com/WhitespaceBot",[25],[161,532,533],{},[21,534,535],{"href":535,"rel":536},"https://twitter.com/BadKnockKnocks",[25],[161,538,539],{},[21,540,541],{"href":541,"rel":542},"https://twitter.com/atticPetalsBot",[25],[161,544,545],{},[21,546,547],{"href":547,"rel":548},"http://poeticalbot.tumblr.com/",[25],[161,550,551],{},[21,552,553],{"href":553,"rel":554},"http://fairytalesbot.tumblr.com/",[25],[161,556,557],{},[21,558,559],{"href":559,"rel":560},"https://twitter.com/portskybot",[25],[161,562,563],{},[21,564,565],{"href":565,"rel":566},"https://twitter.com/NewGunMyths",[25],[161,568,569],{},[21,570,571],{"href":571,"rel":572},"https://twitter.com/GetLampBot",[25],[161,574,575],{},[21,576,577],{"href":577,"rel":578},"https://twitter.com/DrugPackagesBot",[25],[161,580,581],{},[21,582,583],{"href":583,"rel":584},"https://twitter.com/NewMythologies",[25],[161,586,587],{},[21,588,589],{"href":589,"rel":590},"https://twitter.com/numbersbot0001",[25],[161,592,593],{},[21,594,595],{"href":595,"rel":596},"https://twitter.com/numbersbot0002",[25],[161,598,599],{},[21,600,601],{"href":601,"rel":602},"http://twitter.com/KimIlSungismBot",[25],[161,604,605],{},[21,606,607],{"href":607,"rel":608},"https://twitter.com/FairyTaleTitles",[25],[161,610,611],{},[21,612,613],{"href":613,"rel":614},"https://twitter.com/NewsForGoats",[25],[161,616,617],{},[21,618,619],{"href":619,"rel":620},"https://twitter.com/BoingBoingHuffR",[25],[161,622,623],{},[21,624,627],{"href":625,"rel":626},"https://twitter.com/SolanisBot01",[25],"SolanasBot01",[161,629,630],{},[21,631,634],{"href":632,"rel":633},"https://twitter.com/SolanasBot02",[25],"SolanasBot02",[161,636,637],{},[21,638,641],{"href":639,"rel":640},"https://twitter.com/SolanasBot03",[25],"SolanasBot03",{"title":39,"searchDepth":53,"depth":53,"links":643},[644],{"id":459,"depth":53,"text":460},"2019-09-14T00:00:00.000Z","2025-12-29T00:00:00.000Z","Notes on automated bots, mostly posting to Twitter or Tumblr",{},"/blog/automated-bots",{"title":394,"description":647},{"src":652,"mime":131,"alt":653,"width":654,"height":655},"/media/sample.webp","Mountain",1200,630,"blog/automated-bots",[455,658,312,659],"automation","tumblr","3RzqzWOQhzXRlCM0y6KAd4RakK8ss7BJDycoDY_K_9E",{"id":662,"title":663,"author":8,"body":664,"date":645,"dateUpdated":122,"description":714,"excerpt":122,"extension":123,"headline":663,"meta":715,"navigation":126,"path":716,"seo":717,"socialImage":718,"stem":719,"tags":720,"__hash__":724},"blog/blog/watmap.md","WATMAP and other delights",{"type":10,"value":665,"toc":712},[666,670,676,691,700,703],[13,667,669],{"id":668},"we-can-rebuild-it-for-you-wholesale","We can rebuild it for you wholesale!",[17,671,672],{},[149,673],{"alt":674,"src":675},"My son reimagined via WATMAP","/media/watmap.00.png",[17,677,678,679,684,685,690],{},"Processing2/3 code written by ",[21,680,683],{"href":681,"rel":682},"https://github.com/tsulej/GenerateMe/tree/master/watmap",[25],"GenerateMe",". See their ",[21,686,689],{"href":687,"rel":688},"https://generateme.tumblr.com/",[25],"TumblrBlog"," for use and tips.",[17,692,693,694,699],{},"A ",[21,695,698],{"href":696,"rel":697},"http://everythingability.com/",[25],"friend"," thinks of it a \"a poor-man's GAN\". I can see the similarities: an image is \"recreated\", using elements from something else.",[17,701,702],{},"Original developer refers to it as part of a \"glitch-aesthetic\" which I get - but it's not a glitch, an error. There are seeming \"hiccups\" in the discontinuities. It's essentially a tile-mosaic replicator using a quad-tree to focus on sizes. It takes a long time to process, mainly due to the quad-tree preocessing.",[17,704,705,706,711],{},"I thought that ",[21,707,710],{"href":708,"rel":709},"https://www.instagram.com/richard.winters/",[25],"Richard Winters"," (last time I checked, all images had been removed, which makes me sad) was using a custom version inspired by WATMAP, but I've long-since changed my mind. Using square-subsections (instead of variadic-sized rectangles) and processes each color channel (RGB?) separately. So, channel-based tile-sets.",{"title":39,"searchDepth":53,"depth":53,"links":713},[],"A glitch-aesthetic mosaic image-remaker built in Processing by somebody else",{},"/blog/watmap",{"title":663,"description":714},{"src":652,"mime":131,"alt":653,"width":654,"height":655},"blog/watmap",[312,721,722,723],"processing","glitch","tools","GCus75-dbBoVYc4LsyYAqkVEKIrUKqwLZRMqoCuJBm8",1785384162037]